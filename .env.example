# ===== Server-side only (Vercel env vars / n8n credentials). Never commit real values. =====
APP_ENV=staging                      # staging | production
NEXT_PUBLIC_APP_URL=https://app.your-domain.example   # the Next.js companion app (dashboard/admin/API)
WEBFLOW_ORIGIN=https://www.your-domain.example        # the Webflow site origin allowed to POST /api/intake (CORS)

# xAI Grok (docs.x.ai) — OpenAI-compatible Chat Completions at https://api.x.ai/v1, structured outputs via response_format json_schema
XAI_API_KEY=
XAI_MODEL=grok-4.7                   # verified on docs.x.ai 2026-11-03; re-check before launch
XAI_BASE_URL=https://api.x.ai/v1

# Supabase
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_ANON_KEY=                   # browser-safe only because RLS is strict
SUPABASE_SERVICE_ROLE_KEY=           # backend + n8n ONLY
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Stripe (test mode first)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_LOCAL_PRO=price_...     # $99/mo test pricing
STRIPE_PRICE_MULTI_TRADE=price_...   # $199/mo test pricing

# Email
RESEND_API_KEY=re_...
ALERT_FROM_EMAIL="Crewforthat <alerts@mail.your-domain.example>"
OPS_ALERT_EMAIL=ops@your-domain.example

# Shared secrets (generate: openssl rand -hex 32)
N8N_WEBHOOK_SHARED_SECRET=           # app <-> n8n (x-shared-secret header)
INTAKE_SHARED_SECRET=                # optional: server-to-server intake (Webflow webhook relay)
N8N_WF01_WEBHOOK_URL=https://<you>.app.n8n.cloud/webhook/wf01-intake

# Cloudflare Turnstile (public site key goes in the Webflow embed; secret stays here)
# Comma-separated exact origins allowed to POST /api/intake from the browser
WEBFLOW_ORIGIN=https://<site>.webflow.io,https://<site>.design.webflow.com
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAFykd3724PLNQGyS  # public; widget 'Archangel Post a Job' (hosts: archangel-leadgen.vercel.app, webflow.io)

# Webflow Data API v2 (CMS:write scope) — mirrors approved public opportunities
WEBFLOW_API_TOKEN=
WEBFLOW_OPPORTUNITIES_COLLECTION_ID=

# SAM.gov Get Opportunities Public API (n8n env)
SAM_GOV_API_KEY=
SAM_SOURCE_ID=                       # uuid of the 'SAM.gov' row in sources

PRIVACY_VERSION=2026-11-03           # bump when consent/privacy text changes
